<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}net-idea - Modern Web Agency{% endblock %}</title>
    <meta name="description" content="Professional web development agency specializing in Symfony, PHP, modern frontend technologies, and cloud solutions.">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💡</text></svg>">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="fixed w-full bg-white shadow-md z-50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex-shrink-0 flex items-center">
                    <a href="{{ path('home') }}" class="text-2xl font-bold text-gradient">
                        💡 net-idea
                    </a>
                </div>
                
                <!-- Desktop Navigation -->
                <div class="hidden md:flex space-x-8">
                    <a href="#services" class="text-secondary-600 hover:text-primary-600 transition-colors">Services</a>
                    <a href="#technologies" class="text-secondary-600 hover:text-primary-600 transition-colors">Technologies</a>
                    <a href="#about" class="text-secondary-600 hover:text-primary-600 transition-colors">About</a>
                    <a href="#contact" class="text-secondary-600 hover:text-primary-600 transition-colors">Contact</a>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button id="mobile-menu-button" type="button" class="text-secondary-600 hover:text-primary-600 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden">
            <div class="px-2 pt-2 pb-3 space-y-1 bg-white border-t">
                <a href="#services" class="block px-3 py-2 text-secondary-600 hover:text-primary-600 hover:bg-secondary-50 rounded-md">Services</a>
                <a href="#technologies" class="block px-3 py-2 text-secondary-600 hover:text-primary-600 hover:bg-secondary-50 rounded-md">Technologies</a>
                <a href="#about" class="block px-3 py-2 text-secondary-600 hover:text-primary-600 hover:bg-secondary-50 rounded-md">About</a>
                <a href="#contact" class="block px-3 py-2 text-secondary-600 hover:text-primary-600 hover:bg-secondary-50 rounded-md">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow pt-16">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-secondary-900 text-white py-12">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-2xl font-bold mb-4 text-gradient">💡 net-idea</h3>
                    <p class="text-secondary-400">
                        Professional web development agency delivering innovative solutions with modern technologies.
                    </p>
                </div>
                <div>
                    <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
                    <ul class="space-y-2">
                        <li><a href="#services" class="text-secondary-400 hover:text-white transition-colors">Services</a></li>
                        <li><a href="#technologies" class="text-secondary-400 hover:text-white transition-colors">Technologies</a></li>
                        <li><a href="#about" class="text-secondary-400 hover:text-white transition-colors">About Us</a></li>
                        <li><a href="#contact" class="text-secondary-400 hover:text-white transition-colors">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-semibold mb-4">Contact</h4>
                    <p class="text-secondary-400 mb-2">
                        Ready to start your project?
                    </p>
                    <a href="#contact" class="btn btn-primary">Get in Touch</a>
                </div>
            </div>
            <div class="border-t border-secondary-800 mt-8 pt-8 text-center text-secondary-400">
                <p>&copy; {{ "now"|date("Y") }} net-idea. All rights reserved.</p>
            </div>
        </div>
    </footer>

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</body>
</html>
