{% extends 'base.html.twig' %}

{% block title %}net-idea - Professional Web Development Agency{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-gradient text-white py-20 md:py-32">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 animate-slide-up">
                Transform Your Ideas Into Reality
            </h1>
            <p class="text-xl md:text-2xl mb-8 text-gray-100 opacity-90">
                Professional web development agency specializing in modern technologies,
                full software lifecycle management, and innovative digital solutions.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="#services" class="btn bg-white text-primary-600 hover:bg-gray-100 shadow-xl">
                    Explore Services
                </a>
                <a href="#contact" class="btn btn-outline border-white text-white hover:bg-white hover:text-primary-600">
                    Get Started
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section id="services" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="section-title animate-on-scroll">Our Services</h2>
            <p class="section-subtitle animate-on-scroll">
                Comprehensive solutions for your entire software development lifecycle
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for service in services %}
            <div class="service-card animate-on-scroll">
                <div class="icon-box">
                    {{ service.icon }}
                </div>
                <h3 class="text-2xl font-bold text-secondary-900 mb-3">
                    {{ service.title }}
                </h3>
                <p class="text-secondary-600 mb-4">
                    {{ service.description }}
                </p>
                <div class="space-y-2">
                    {% for feature in service.features %}
                    <div class="flex items-center text-sm text-secondary-700">
                        <svg class="w-5 h-5 text-primary-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        {{ feature }}
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Technologies Section -->
<section id="technologies" class="py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="section-title animate-on-scroll">Our Technology Stack</h2>
            <p class="section-subtitle animate-on-scroll">
                Leveraging cutting-edge technologies to build robust and scalable solutions
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {% for category, techs in technologies %}
            <div class="card animate-on-scroll">
                <h3 class="text-xl font-bold text-secondary-900 mb-4 flex items-center">
                    <span class="w-2 h-2 bg-primary-600 rounded-full mr-2"></span>
                    {{ category }}
                </h3>
                <div class="flex flex-wrap gap-2">
                    {% for tech in techs %}
                    <span class="tech-badge">{{ tech }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="py-20 bg-gradient-to-br from-primary-50 to-purple-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="section-title animate-on-scroll">About net-idea</h2>
                <p class="section-subtitle animate-on-scroll">
                    Your trusted partner in digital transformation
                </p>
            </div>

            <div class="card animate-on-scroll">
                <div class="prose prose-lg max-w-none">
                    <p class="text-secondary-700 mb-6">
                        At <strong class="text-gradient">net-idea</strong>, we are passionate about creating innovative web solutions 
                        that drive business success. With expertise spanning the entire software development lifecycle, 
                        we transform complex challenges into elegant, scalable solutions.
                    </p>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
                        <div class="flex items-start">
                            <div class="flex-shrink-0 bg-primary-100 rounded-lg p-3 mr-4">
                                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-secondary-900 mb-2">Agile Methodology</h4>
                                <p class="text-secondary-600 text-sm">We follow Scrum practices for efficient project delivery and continuous improvement.</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 bg-primary-100 rounded-lg p-3 mr-4">
                                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-secondary-900 mb-2">Modern Tech Stack</h4>
                                <p class="text-secondary-600 text-sm">Utilizing the latest frameworks and tools to ensure your project stays ahead.</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 bg-primary-100 rounded-lg p-3 mr-4">
                                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-secondary-900 mb-2">Performance First</h4>
                                <p class="text-secondary-600 text-sm">Optimized code and infrastructure for lightning-fast applications.</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 bg-primary-100 rounded-lg p-3 mr-4">
                                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-secondary-900 mb-2">Security & Quality</h4>
                                <p class="text-secondary-600 text-sm">Best practices and thorough testing ensure secure, reliable solutions.</p>
                            </div>
                        </div>
                    </div>
                    
                    <p class="text-secondary-700">
                        Whether you need a complete digital platform, API integration, or cloud infrastructure, 
                        our team of experienced developers is ready to bring your vision to life with cutting-edge 
                        technology and professional expertise.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-20 bg-secondary-900 text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll">
                Ready to Start Your Project?
            </h2>
            <p class="text-xl text-gray-300 mb-8 animate-on-scroll">
                Let's discuss how we can help transform your ideas into successful digital solutions.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
                <div class="bg-secondary-800 rounded-lg p-6 animate-on-scroll">
                    <div class="text-4xl mb-3">📧</div>
                    <h4 class="font-semibold mb-2">Email Us</h4>
                    <a href="mailto:info@net-idea.com" class="text-primary-400 hover:text-primary-300">info@net-idea.com</a>
                </div>
                
                <div class="bg-secondary-800 rounded-lg p-6 animate-on-scroll">
                    <div class="text-4xl mb-3">💬</div>
                    <h4 class="font-semibold mb-2">Let's Talk</h4>
                    <p class="text-gray-400">Schedule a consultation</p>
                </div>
                
                <div class="bg-secondary-800 rounded-lg p-6 animate-on-scroll">
                    <div class="text-4xl mb-3">📍</div>
                    <h4 class="font-semibold mb-2">Visit Us</h4>
                    <p class="text-gray-400">Remote & On-site Available</p>
                </div>
            </div>
            
            <div class="mt-12 animate-on-scroll">
                <a href="mailto:info@net-idea.com" class="btn bg-primary-600 text-white hover:bg-primary-700 text-lg px-8 py-4">
                    Get Started Today
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
